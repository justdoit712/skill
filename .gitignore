# 密钥与本地配置（需求 §7.4）
# 只允许提交 .env.example 与不含凭据的 config/*.json；真实凭据仅放 GitHub Secrets。
.env
.env.*
!.env.example
config/*.local.json

# Python
__pycache__/
*.py[cod]
*.so
venv/
.venv/
ENV/

# 日志与临时文件
logs/
*.log
*.tmp
*.bak
.cache/

# 运行期暂存：上游原文，仅在同一 runner 内复用，不入库
data/state/texts/

# IDE 与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
