{
  "model_config_version": "1.0.0",
  "provider_id": "ollama",
  "provider": "ollama",
  "name": "Ollama 本地模型 (零成本)",
  "endpoint": "http://localhost:11434/v1/chat/completions",
  "model": "qwen2.5:14b",
  "auth": {
    "type": "bearer",
    "api_key_env": "LLM_API_KEY",
    "key_ref": "ollama"
  },
  "request": {
    "timeout_seconds": 600,
    "max_attempts": 2,
    "temperature": 0
  },
  "limits": {
    "max_input_bytes": 262144,
    "max_output_tokens": 8000,
    "max_calls_per_week": 50,
    "max_total_tokens_per_run": 100000000
  }
}
