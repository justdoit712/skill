    },
    "security": {
      "zh": ["漏洞检测", "代码安全", "审计"],
      "en": ["vulnerability", "code security", "audit", "static analysis"]
    },
    "finance": {
      "zh": ["宏观", "地缘", "大宗商品", "期货", "黄金", "白银", "股票", "财报", "汇率", "利率", "回测", "能源"],
      "en": ["macro", "geopolitical", "commodities", "futures", "gold", "silver", "stock", "earnings", "forex", "interest rate", "backtest", "energy"],
      "spec_provided": ["宏观", "地缘", "大宗商品", "期货", "黄金", "白银"]
