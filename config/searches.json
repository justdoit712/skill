  "global_exclusions": {
    "query_terms": ["-dsh", "-clawhub"],
    "orgs": ["awesome-dsh-plugin", "huggingface"],
    "repos": ["justdoit712/skill"],
    "post_filter": [
      "按 config/taxonomy.json 的 hard_exclusions 排除 DSH 插件、实盘自动下单、面向专业临床诊断与治疗决策的技能",
      "按 not_standalone_directions 排除仅属科研、通用数据分析、AI 开发的条目",
      "普通仓库、空模板、插件容器或整个合集不能计为一个独立技能",
      "只有 MCP 服务、无独立技能说明的普通工具不计入",
      "合集仓库尽量展开到具体技能；多个来源指向同一技能时去重并保留全部发现依据"
    ]
  }
}
