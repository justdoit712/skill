{
  "version": "1.0.0",
  "source": "docs/Skills导航目录二开需求.md §4.2、§4.3",
  "constraint": "每个领域配置中英文搜索词，搜索至少约束到 SKILL.md 文件。",
  "note": "词表是发现手段，命中后仍需判别实际用途。金融、心理健康、身体健康三类包含 §4.3 直接给出的词条，其余由 §3.1 的收录内容派生。",
  "api": {
    "endpoint": "GET https://api.github.com/search/repositories?q={query}",
    "auth": "未认证 / 带 token（GitHub Actions 使用最小权限运行时 token）",
    "rate_limits": {
      "unauthenticated": { "search": "10 次/分钟", "core": "60 次/小时" },
      "authenticated": { "search": "30 次/分钟", "core": "5000 次/小时" }
    },
    "pagination": "per_page 上限 100，page 递增；结果超过 1000 条时 GitHub 限制搜索深度，需细分查询词而不是翻页到底",
    "implementation_note": "未认证额度不足以跑全量发现。本地只能抽样验证逻辑，全量采集必须在 Actions 中带 token 运行。"
  },
  "file_constraint": {
    "requirement": "至少约束到 SKILL.md",
    "query_template": "{term} \"SKILL.md\"",
    "repo_search_limit": "仓库搜索不校验文件名，把 SKILL.md 作为词条只能提高命中率，无法精确限定到文件",
    "precise_option": "代码搜索支持 filename:SKILL.md，可精确限定，但必须认证（见 api.auth）"
  },
  "spec_provided_terms": [
    "宏观/macro",
    "地缘/geopolitical",
    "大宗商品/commodities",
    "期货/futures",
